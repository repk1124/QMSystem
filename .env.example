# ============================================================
# QuotationMaster 環境變數
# 複製成 .env 後修改；scripts/setup.sh / setup.ps1 會自動產生並填入隨機密鑰。
# ============================================================

# ── 必填 ──
# session 加密用的隨機字串（至少 32 字元）。洩漏等於所有登入狀態可被偽造。
#   產生方式：openssl rand -hex 32
SESSION_SECRET=

# Docker 內建 PostgreSQL 的密碼（setup 腳本會自動產生）
POSTGRES_PASSWORD=
POSTGRES_USER=qm
POSTGRES_DB=quotationmaster

# ── 資料庫連線（非 Docker 執行時才需要；Docker 版由 docker-compose.yml 自動組出）──
# 雲端託管的 DB 請加上 ?sslmode=require
DATABASE_URL=postgresql://qm:changeme@localhost:5432/quotationmaster

# ── 初始管理員（只在資料庫裡「一個使用者都沒有」時使用）──
# 不設 INITIAL_ADMIN_PASSWORD 的話，第一次啟動會印一組隨機密碼在 log（docker compose logs app）
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@example.com
# 至少 12 字元；首次登入後會強制修改
INITIAL_ADMIN_PASSWORD=

# ── 選填 ──
# 對外埠（Docker）：瀏覽器用 http://主機:APP_PORT
APP_PORT=5000
# 應用程式監聽埠（非 Docker）
PORT=5000
# 上傳檔案存放目錄（非 Docker；Docker 版固定 /app/uploads 並掛 volume）
UPLOAD_DIR=./uploads
# PostgreSQL 連線池上限
PG_POOL_MAX=10
# session cookie 是否只在 HTTPS 下送出：auto（預設，走 HTTPS 才標 Secure）/ true / false
COOKIE_SECURE=auto
